# Copiez ce fichier vers .env.local. Docker Compose et le CLI Convex le lisent.
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
CONVEX_DASHBOARD_PORT=6791

# Remplacez localhost par les domaines HTTPS publics avant un déploiement.
VITE_CONVEX_URL=http://localhost:3210
VITE_CONVEX_SITE_URL=http://localhost:3211
CONVEX_CLOUD_ORIGIN=http://localhost:3210
CONVEX_SITE_ORIGIN=http://localhost:3211

# Renseignez cette clé après `pnpm selfhost:key`.
CONVEX_SELF_HOSTED_URL=http://localhost:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Générez une valeur sûre pour l’URL avec `openssl rand -hex 32`.
POSTGRES_PASSWORD=
POSTGRES_VERSION=17-alpine

# Épinglez ces versions en production après avoir validé une version donnée.
CONVEX_BACKEND_VERSION=latest
CONVEX_DASHBOARD_VERSION=latest
